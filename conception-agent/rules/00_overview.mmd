flowchart TD
    %% Global Styling
    classDef rule fill:#fdf2f8,stroke:#be185d,stroke-width:2px,color:#be185d;
    classDef workflow fill:#eff6ff,stroke:#1d4ed8,stroke-width:2px,color:#1e3a8a;
    classDef skill fill:#f0fdf4,stroke:#15803d,stroke-width:2px,color:#14532d;
    classDef highlight fill:#fff7ed,stroke:#c2410c,stroke-width:2px,stroke-dasharray: 5 5;

    subgraph Rules [rules/: Règles Transversales]
        direction TB
        R1([Identity & Persona]):::rule
        R2([Stack Architecture]):::rule
        R3([Quality & Security]):::rule
        R4([Implementation Protocol]):::rule
    end

    subgraph Workflows [workflows/: Processus Séquentiels]
        direction TB
        W_Init[[Init Structure]]:::workflow
        W_Analyze[[Analyze & UI Decomp]]:::workflow
        W_UI[[UI-Kit Dev]]:::workflow
        W_Wire[[3-Tier Implementation]]:::workflow

        W_Init --> W_Analyze
        W_Analyze --> W_UI
        W_UI --> W_Wire
    end

    subgraph Skills [skills/: Capacités Spécialisées]
        direction TB
        S_UI{{UI Researcher / Tailwind}}:::skill
        S_Logic{{Business Logic Expert}}:::skill
        S_Data{{PDO Repository Master}}:::skill
        S_Integrator{{Tier 1 Integrator}}:::skill
    end

    %% Relations Workflows -> Skills
    W_UI -.->|Utilise| S_UI
    W_Wire -.->|Utilise| S_Data
    W_Wire -.->|Utilise| S_Logic
    W_Wire -.->|Utilise| S_Integrator

    %% Relations Rules -> Workflows (Constraintes)
    R2 ==>|Impose Structure| W_Init
    R4 ==>|Impose Protocole| W_Analyze
    R1 -.->|Guide| Workflows

    %% Link Styling
    linkStyle default stroke:#64748b,stroke-width:1px;
