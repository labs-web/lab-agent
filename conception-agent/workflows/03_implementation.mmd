flowchart LR
    %% Classes Styling
    classDef t1 fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0c4a6e;
    classDef t2 fill:#fff7ed,stroke:#ea580c,stroke-width:2px,color:#7c2d12;
    classDef t3 fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#14532d;
    classDef ext fill:#f3f4f6,stroke:#4b5563,stroke-width:2px,stroke-dasharray: 5 5;

    subgraph Tier1 [Tier 1 : Présentation / Access Point]
        direction TB
        Route([Route index.php]):::t1 --> Ctrl[[Controller]]:::t1
        Ctrl --> View{{View PHP + HTML}}:::t1
    end
    
    subgraph Tier2 [Tier 2 : Logique Métier / Brain]
        direction TB
        Service[[Service Layer]]:::t2
        Exception>Domain Exceptions]:::t2
        Service -.-> Exception
    end
    
    subgraph Tier3 [Tier 3 : Données / Persistence]
        direction TB
        Repo[[Repository PDO]]:::t3
        Entity([Entity DTO]):::t3
        DB[(MySQL Database)]:::t3
    end
    
    %% Flux d'exécution
    Route -->|Dispatch| Ctrl
    Ctrl ==>|Appelle| Service
    Service ==>|Valide/Traite| Service
    
    Service ==>|Appelle| Repo
    Repo -->|SQL Query| DB
    DB -->|Result Set| Repo
    Repo -->|Hydrate| Entity
    Entity -.->|Retourne| Service
    
    Service -.->|Retourne| Ctrl
    Ctrl -.->|Injecte Data| View
    
    %% Dépendances UI-Kit
    UIKit[("UI-Kit (Static HTML)")]:::ext -.->|Hydratation| View
    
    %% Styles
    linkStyle default stroke:#64748b,stroke-width:1px;
